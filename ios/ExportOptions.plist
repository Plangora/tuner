<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Signing method: manual, so the provisioningProfiles mapping below is
	     actually honored. "automatic" ignores that mapping and has Xcode try
	     to auto-manage/create a profile itself, which requires network
	     access to the Apple Developer portal and fails headlessly in CI
	     with "No profiles for '<bundle id>' were found". -->
	<key>signingStyle</key>
	<string>manual</string>

	<!-- Team ID: Your Apple Developer Team ID -->
	<!-- Find at: https://developer.apple.com/account/#!/membership -->
	<key>teamID</key>
	<string>588QQUR9UG</string>

	<!-- Method: app-store-connect for App Store/TestFlight submission
	     ("app-store" is deprecated as of recent Xcode versions) -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Provisioning profile mapping -->
	<!-- Maps bundle ID to provisioning profile UUID -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.plangora.tuner</key>
		<string>Tuner_AppStore</string>
	</dict>

	<!-- Code signing identity: matches the certificate name in Keychain -->
	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<!-- Strip Swift symbols for faster distribution -->
	<key>stripSwiftSymbols</key>
	<true/>

	<!-- Manage signing automatically (Xcode handles certificate selection) -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<!-- Enable bitcode for smaller download sizes (optional) -->
	<key>uploadBitcode</key>
	<false/>

	<!-- Symbol upload for crash reporting (recommended for App Store apps) -->
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
